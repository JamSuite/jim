# jimconf.toml — project-level path overrides for the jim plugin.
#
# Copy this file to `jimconf.toml` at your project root and edit the
# values you want to override. Any key you omit keeps its default.
#
# IMPORTANT: changing a value here does NOT move existing files. If you
# point `architecture_path` at a new location, you are responsible for
# moving (or recreating) ARCHITECTURE.md at the new path. jim never
# rewrites or relocates files based on a config change.
#
# Format: flat top-level `KEY = "value"` lines. Comments start with #.
# Nested TOML tables and arrays are silently ignored — flat config only.
#
# Inspect what jim will resolve from this file:
#   /jim:conf list                     # active project config
#   /jim:conf -c jimconf.toml.example list   # see the shipped defaults

specs_path        = "docs/specs"
architecture_path = "ARCHITECTURE.md"
vision_path       = "VISION.md"
roadmap_path      = "ROADMAP.md"
brainstorms_path  = "docs/brainstorms"
debug_path        = "docs/debug"
issues_path       = "./docs/issues/"

# Project-tier context map (spec 033) — the tier-0 blueprint gluing the
# group blueprints into one project scope. Written only through the
# /jim:blueprint surface (bare invocation). Root-level by default.
blueprint_path    = "BLUEPRINT.md"

# Optional project-script path for the per-commit gate. Resolves the
# path-where-it-would-live; /jim:build wraps the call in an existence
# gate, so a missing file is silently skipped (no warning, no error).
pre_commit_path        = "./pre-commit.sh"

# Optional project-script path for the pre-completion gate. Runs once
# at the end of /jim:build (replaces the per-commit gate's invocation
# at completion). Same existence-gated semantics as pre_commit_path.
pre_completion_path    = "./pre-completion.sh"

# Enforcement flags for the gates above. When "true", a missing script
# at the configured path halts the build instead of being skipped
# silently. Double-quoted string booleans — "true" enables, anything
# else (including the default "false") disables.
require_pre_commit     = "false"
require_pre_completion = "false"

# Post-build arch-feedback loop. When "true", /jim:build auto-invokes
# /jim:arch after a successful pre-completion gate and lets it write
# ARCHITECTURE.md updates directly (bypassing the user-confirmation
# prompt). Default "false" keeps the existing /jim:arch review step.
auto_arch_feedback = "false"

# When "true", the blueprint update (and /jim:blueprint generate) writes a
# group's 000-blueprint spec directly instead of the diff-and-confirm prompt.
# Default "false" keeps the review step. Applies to both the review-triggered
# and ad-hoc update paths.
auto_blueprint = "false"

# Post-review blueprint-update gate. When "true", the blueprint update that runs
# after /jim:review is a required, blocking step: the review is not treated as
# complete until the update has run to completion. The update's proposed changes
# stay advisory — it is the uncompleted step that blocks, not the changes. Gates
# only the review trigger; the ad-hoc `/jim:blueprint <group> --since <ref>`
# update is developer-invoked and ungated. Default "false".
require_blueprint = "false"

# Opt-in staleness threshold for the blueprint regen cadence (spec 032): an
# integer count of targeted updates accumulated since the last full generate.
# When the count reaches it, /jim:blueprint update mode runs a full whole-group
# regeneration instead of another targeted diff (unattended under auto_blueprint,
# still criticality-graded; otherwise it prompts). Default "0" disables the
# trigger, leaving update mode signal-only — it still reports "N targeted updates
# since last full generate". Any non-positive-integer value is treated as disabled.
blueprint_regen_threshold = "0"

# --- Spec-group partition doctrine (spec 033) ------------------------------

# Partition axis the map-creation proposal steers toward. "vertical" (the
# default) proposes domain-vertical bounded contexts; "layered" is the
# escape hatch for layer-style partitions — doctrine guidance and straddle
# messaging recalibrate, and groups carry role "layer". Steers proposal
# doctrine only; what each group IS lives in its BLUEPRINT.md role field.
group_axis = "vertical"

# How group↔code binding is captured in the map:
#   directory      : each group owns a subtree (strongest mechanical checks)
#   declared-paths : the map lists each group's code locations (default)
#   none           : no code binding; boundary lives in specs/blueprints only
# Territory is recorded as data; enforcement arrives with the verification
# engine (issue #22). Territory entries are optional-when-unknown.
group_territory = "declared-paths"

# --- Post-build review gate -----------------------------------------------

# Post-build review (/jim:review) verifies what the build shipped against the
# spec, plan, and architecture. When "true", the review is a required, blocking
# phase: /jim:build holds the completion gate until the review has run to
# completion — the build cannot be marked complete without it. The review's
# findings stay advisory (a report, not a veto); it is the uncompleted phase
# that blocks, not the findings. Default "false" makes /jim:build merely offer it.
require_review = "false"

# Run the post-build review automatically with no prompt at the completion
# gate. Composes independently of auto_issue_file: auto_review controls
# invocation only; the review's issue batch stays interactive unless
# auto_issue_file is also "true". Default "false".
auto_review = "false"

# Depth of the review's deep-investigation pass (spec 027). "thorough" (the
# default) triages the build's diff and fans out read-only investigator
# subagents on the high-stakes changes; "lean" skips the broad fan-out and
# investigates only security-relevant regions. A per-run
# `/jim:review --depth lean|thorough` overrides this for one run.
# review_depth = "thorough"

# Model for the investigator subagents (the per-spawn Agent model).
# "inherit" (the default) runs them on the session model; or pin a tier:
# "sonnet" | "opus" | "haiku". Anything else falls back to "inherit". The
# review's own orchestration and alignment verdict always run on the
# session model, which jim does not set.
# review_model = "inherit"

# Investigator fan-out cap: the maximum number of investigator subagents
# dispatched per review, highest-stakes first; bounded coverage is named in
# review.md rather than silently truncated. A non-positive/non-numeric value
# falls back to 10, and a cap of 0 never silently disables the fan-out.
# Default "10".
# review_fanout_cap = "10"

# --- Security review gates and behavior -----------------------------------

# Hard-gate security review at phase boundaries. When "true":
#   /jim:plan halts at its start until the spec has been reviewed
#   (security.md present with reviewed_phases including "spec").
#   /jim:build halts at its start until the plan has been reviewed
#   (security.md present with reviewed_phases including "plan").
# The gate produces the missing review by invoking /jim:sec; the developer
# remains in the loop for routing decisions. Default "false".
require_security          = "false"

# Same gate semantics as require_security, but findings are routed to
# spec.md or plan.md automatically without per-finding prompts. The
# developer is not interrupted during the gate cycle. If both
# require_security and auto_security are "true", auto_security takes
# precedence (the more aggressive setting). Default "false".
auto_security             = "false"

# Repeat the gated security-review-and-routing cycle until the configured
# severity threshold is clear (or the iteration limit is reached).
# Default "false".
require_security_loop     = "false"

# Severity threshold for the loop's exit condition. When require_security_loop
# is "true", the loop exits once no findings remain at or above this
# severity. Values: "critical" | "notable" | "advisory". Default "critical".
require_security_loop_sev = "critical"

# Maximum iterations of the gated review-and-routing loop. When the limit
# is reached with findings still present at or above require_security_loop_sev,
# the workflow halts with an error listing the unresolved findings.
# Integer-as-string. Default "5".
auto_security_loop_limit  = "5"

# Default base directory for ad-hoc /jim:sec file output when the
# developer opts into writing findings during an ad-hoc review. The skill
# writes to {security_adhoc_path}/{YYYYMMDD}-{slug}.md when accepted.
# No file is written unless the developer accepts at the end-of-review
# prompt. Default "docs/security".
security_adhoc_path       = "docs/security"

# --- Issue tracking workflow integration (spec 018) -----------------------

# Master switch for end-of-phase candidate batch surfacing across the 7
# surfacing skills (/jim:spec, /jim:research, /jim:plan, /jim:build,
# /jim:brainstorm, /jim:debug, /jim:sec). When "true" (the default),
# each skill presents a batch of candidate issues at the conclusion of
# its run before its final approval/STOP step. When "false", no batch
# surfaces and ad-hoc /jim:issue is the only capture path. The bare
# (non-auto_-prefixed) name reflects that the default behavior keeps the
# human in the loop: surfacing presents a choice, not an automated
# action. Uncomment to override the default.
# issue_capture = "true"

# Quiet auto-file mode for the candidate batch. When "true" AND
# issue_capture is also "true", the batch is filed without prompting:
# every candidate is written silently, the user sees a one-line summary,
# and review happens later via /jim:issue list. When "false" (the default),
# the batch prompts per the batch UX (file all / skip all / per-row
# file/edit/skip). auto_issue_file = "true" with issue_capture = "false"
# is a no-op. Uncomment to enable.
# auto_issue_file = "false"

# --- Issue list view (spec 019) -------------------------------------------

# Default view for `/jim:issue list`. An explicit filter argument
# (e.g. `/jim:issue list open`) overrides the configured default per call.
# Unrecognized values fall back to the documented default.
#   issue_list_group : how rows are grouped — status | priority | origin | none
#   issue_list_sort  : sort within each group — date | priority | num
#   issue_list_cols  : comma-separated columns from
#                      num,date,priority,status,slug,labels,title
#   issue_list_order : sort direction — desc (default) | asc
#   issue_list_closed: include closed issues in the default / priority-filtered
#                      views — false (default) | true. An explicit
#                      `list open` / `list closed` filter always overrides it.
# issue_list_group  = "status"
# issue_list_sort   = "date"
# issue_list_cols   = "num,date,priority,title"
# issue_list_order  = "desc"
# issue_list_closed = "false"

# --- Issue id prefix (spec 021) -------------------------------------------

# The prefix segment of an issue id (the part before the slug). Default
# "date" keeps the zero-config YYYYMMDD- naming. Presets:
#   date       : YYYYMMDD-<slug>             (default)
#   sequential : zero-padded display ordinal, e.g. 0042-<slug>
#   project    : the static issue_id_project tag, e.g. JIM-<slug>
#   timestamp  : sub-day resolution, e.g. 20260614T144530-<slug>
# Or a custom template combining literal text with {date:FMT} and
# {seq[:width]} tokens, e.g. "JIM-{date:%Y%m%d}-{seq:03}". A malformed value
# is reported on stderr and falls back to the date default. Changing this is
# forward-only — it renames no existing files; converge the legacy collection
# onto the new scheme with `migrate.sh prefix` (spec 023).
# issue_id_prefix = "date"

# Static project tag used by the "project" preset (also usable as literal
# text in a template). Empty by default.
# issue_id_project = "JIM"

# --- Verification engine (spec 035) ---------------------------------------

# /jim:verify checks a group's code against its 000-blueprint's recorded
# invariants: a zero-config mechanical floor (pattern/structure), an
# operator-configured registry of project tooling, and a criticality-gated
# read-only LLM judge. All keys below are optional — the engine runs out of
# the box with these defaults.

# Appetite: the criticality threshold at which the expensive judge rung runs.
# The mechanical floor ALWAYS runs and is never gated by this. Values:
# "critical" | "high" | "medium" | "low". Default "low" is the thorough
# setting — every criticality is judge-eligible; the knob only ever RAISES the
# bar (e.g. "high" judges only critical+high invariants, reporting the rest
# "skipped by appetite" — never silently dropped). A malformed value degrades
# to "low" and the fallback is noted in the run's report. A per-run
# `/jim:verify --appetite <level>` overrides this for one run.
# verify_appetite = "low"

# Per-group appetite override — dynamic suffix, one per group. Overrides
# verify_appetite for that group only (precedence: --appetite flag > per-group
# > global > default). The <group> suffix must be a slug.
# verify_appetite_auth = "critical"

# Judge fan-out cap: the maximum number of judge subagents dispatched per run,
# highest-criticality first; any remainder is named in the report. Mirrors
# review_fanout_cap — a non-positive/non-numeric value falls back to 10, and a
# cap of 0 never silently disables the fan-out. Default "10".
# verify_fanout_cap = "10"

# Model for the judge subagents (the per-spawn Agent model). "inherit" (the
# default) runs them on the session model; or pin a tier:
# "sonnet" | "opus" | "haiku" | "fable". Anything else falls back to "inherit".
# verify_model = "inherit"

# Per-command timeout (seconds) for REGISTRY command execution only — the
# native floor and the judges are not governed by it. Expiry folds into that
# one check's "failed" outcome; the run always continues. A
# non-positive/non-numeric value falls back to 120. Default "120".
# verify_registry_timeout = "120"

# The operator-owned registry — dynamic suffix, one command per entry. A
# blueprint invariant with check `registry:<name>` runs ONLY the command
# string you place in verify_command_<name> here; the <name> suffix must be a
# slug. This is the trust boundary: nothing recorded in a blueprint, code, or
# any scanned artifact can introduce, alter, or activate a command — the
# blueprint only PROPOSES a name, and this config ACTIVATES it. An unconfigured
# name reports "not configured" and executes nothing. Registry commands receive
# no blueprint-derived arguments; each is a complete, self-contained invocation.
# They run through Claude Code's normal permission prompt (like the pre_commit
# hook), so you approve each one at run time.
# verify_command_linecount = "scripts/check-line-budget.sh"
# verify_command_typecheck = "npm run typecheck"

# The partition extractor registry (spec 038) — the same dynamic-suffix,
# one-command-per-entry pattern for /jim:partition. Each deps_command_<name>
# emits a project dependency graph, one edge per line, as
# `<from-relpath>\t<to-relpath>[\t<channel>]`; /jim:partition runs it via a
# normal Bash permission prompt (bounded by verify_registry_timeout) and feeds
# its output through `jimpartition.sh ingest`, which validates and tracks every
# endpoint. The <name> suffix must be a slug and names the coupling channel
# (events, di, ...). Same trust boundary as the verify registry: nothing in
# scanned code, a spec, or the map can introduce or activate a command — this
# config is the only activation channel. With none configured, /jim:partition
# falls back to its native import scan. `/jim:partition` can scaffold an adapter
# and PRINT the exact line for you to paste here — it never writes it itself.
# deps_command_events = "scripts/jim-extract-events.sh"
# deps_command_di = "node scripts/extract-di-graph.js"
